{
  "schema_version": 1,
  "project_name": "async_state_merge_control",
  "source_paths": [
    "subject.py",
    "workflow/**"
  ],
  "tools": {},
  "checks": {
    "loop_threshold": 3,
    "preserve_state_keys": [
      "request_id"
    ]
  },
  "validation": {
    "repetitions": 2,
    "commands": [
      {
        "name": "target",
        "kind": "target",
        "argv": [
          "{python}",
          "-m",
          "evaluator",
          "target"
        ],
        "timeout_seconds": 15,
        "expected_cases": [
          "target:1",
          "target:2"
        ]
      },
      {
        "name": "regression",
        "kind": "regression",
        "argv": [
          "{python}",
          "-m",
          "evaluator",
          "regression"
        ],
        "timeout_seconds": 15,
        "expected_cases": [
          "regression:1",
          "regression:2"
        ]
      }
    ]
  },
  "policy": {
    "max_candidates": 3,
    "max_model_calls": 5,
    "max_context_chars": 24000,
    "max_changed_files": 3,
    "max_changed_lines": 120,
    "protected_paths": [
      "recording.json",
      "evaluator.py"
    ]
  }
}
