{
  "schema_version": 1,
  "project_name": "customer-agent-demo",
  "source_paths": [
    "agent.py"
  ],
  "tools": {
    "lookup_customer": {
      "input_schema": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "pattern": "^C[0-9]{3}$"
          }
        },
        "required": [
          "customer_id"
        ],
        "additionalProperties": false
      },
      "aliases": {
        "user_id": "customer_id"
      }
    }
  },
  "checks": {
    "loop_threshold": 3,
    "preserve_state_keys": []
  },
  "validation": {
    "commands": [
      {
        "name": "customer_lookup",
        "kind": "target",
        "argv": [
          "{python}",
          "checks.py",
          "target"
        ],
        "timeout_seconds": 20,
        "expected_cases": [
          "Target.test_customer_one",
          "Target.test_customer_two",
          "Target.test_unknown_customer",
          "Target.test_invalid_identifier"
        ]
      },
      {
        "name": "existing_features",
        "kind": "regression",
        "argv": [
          "{python}",
          "checks.py",
          "regression"
        ],
        "timeout_seconds": 20,
        "expected_cases": [
          "Regression.test_direct_tool",
          "Regression.test_email_lookup",
          "Regression.test_missing_email",
          "Regression.test_return_value_does_not_mutate_storage"
        ]
      }
    ],
    "repetitions": 2,
    "docker_image": "python:3.11-slim"
  },
  "policy": {
    "protected_paths": [
      "checks.py",
      "record_trace.py",
      "doctor.json"
    ],
    "max_candidates": 3,
    "max_changed_files": 2,
    "max_changed_lines": 30,
    "max_model_calls": 8,
    "max_context_chars": 48000
  }
}
