{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "input_schema": {
            "type": [
              "object",
              "boolean"
            ]
          },
          "aliases": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "input_schema"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "object",
      "properties": {
        "loop_threshold": {
          "type": "integer",
          "minimum": 2
        },
        "preserve_state_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "target",
                  "regression"
                ]
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600
              }
            },
            "required": [
              "name",
              "kind",
              "argv"
            ],
            "additionalProperties": false
          }
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "docker_image": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "commands"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_changed_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_changed_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_context_chars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 200000
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project_name",
    "source_paths",
    "tools",
    "validation"
  ],
  "additionalProperties": false
}
